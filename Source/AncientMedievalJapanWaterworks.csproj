<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net472</TargetFramework>
    <LangVersion>7.3</LangVersion>
    <AssemblyName>AncientMedievalJapanWaterworks</AssemblyName>
    <RootNamespace>AncientMedievalJapan.Waterworks</RootNamespace>
    <OutputPath>../Assemblies/</OutputPath>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
  </PropertyGroup>
  <PropertyGroup Condition="'$(RimWorldDir)' != ''">
    <RimWorldManagedDir>$(RimWorldDir)/RimWorldWin64_Data/Managed</RimWorldManagedDir>
  </PropertyGroup>
  <ItemGroup>
    <!-- Compile-only reference; Harmony is loaded from the required Harmony Mod. -->
    <PackageReference Include="Lib.Harmony.Ref" Version="2.3.3" />
    <Reference Include="Assembly-CSharp"><HintPath>$(RimWorldManagedDir)/Assembly-CSharp.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="UnityEngine.CoreModule"><HintPath>$(RimWorldManagedDir)/UnityEngine.CoreModule.dll</HintPath><Private>false</Private></Reference>
  </ItemGroup>
</Project>